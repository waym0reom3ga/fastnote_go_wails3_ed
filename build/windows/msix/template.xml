<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="fastnote"
        Arguments=""
        InstallLocation="C:\Program Files\FastNote\FastNote">
    </Installer>
    <PackageInformation
        PackageName="FastNote"
        PackageDisplayName="FastNote"
        PublisherName="CN=FastNote"
        PublisherDisplayName="FastNote"
        Version="0.1.0.0"
        PackageDescription="FastNote - Markdown Editor">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.fastnote.editor"
                Description="FastNote - Markdown Editor"
                DisplayName="FastNote"
                ExecutableName="fastnote"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>FastNote</DisplayName>
            <PublisherDisplayName>FastNote</PublisherDisplayName>
            <Description>FastNote - Markdown Editor</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="fastnote.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
